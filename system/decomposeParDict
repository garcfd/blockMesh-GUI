FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 4;

method        simple;

simpleCoeffs
{
    n           (2 2 1);  // Splits: 2 in X, 2 in Y, 1 in Z
    delta       0.001;    // Cell skewness factor (default)
}

