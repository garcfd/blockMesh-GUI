FoamFile
{
    format      ascii;
    class       volScalarField;
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];

// Initial estimate (e.g. C_mu^0.75 * k^1.5 / L)
internalField   uniform 0.019;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.019;
    }

    outlet
    {
        type            zeroGradient;
    }

    sides
    {
        type            slip;
    }

    top
    {
        type            slip;
    }

    ground
    {
        type            epsilonWallFunction;
        value           uniform 0.019;
    }

    body
    {
        type            epsilonWallFunction;
        value           uniform 0.019;
    }
}

