FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

// Example initial estimate (e.g. k = 1.5 * (U * I)^2 for U=20 m/s, I=5% -> k ~ 1.5)
internalField   uniform 0.06;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 0.06;
    }

    outlet
    {
        type            zeroGradient;
    }

    sides
    {
        type            slip;
    }

    top
    {
        type            slip;
    }

    ground
    {
        type            kqRWallFunction;
        value           uniform 0.06;
    }

    body
    {
        type            kqRWallFunction;
        value           uniform 0.06;
    }
}

